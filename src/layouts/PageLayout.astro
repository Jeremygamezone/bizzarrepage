---
import '@fontsource/taviraj/400.css';
import '@fontsource/taviraj/600.css';
import '@fontsource/taviraj/700.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';

import MenuComponent from '../components/MenuComponent.vue';
import Footer from '../components/Footer.astro';
import ValidationPortal from '../components/ValidationPortal';

const {
    title = 'Auténtica de mi Pueblo - Raicilla Artesanal',
    description = '',
    keywords = 'raicilla,agave,botellas,tequila,jalisco,raicilleria,empresa,tradicional,mixologia,organica,productos'
} = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="index, follow" />
        <meta name="keywords" content={keywords} />
        <meta property="og:image" content="https://autenticademipueblo.com/og.jpg" />
        <meta property="twitter:image" content="https://autenticademipueblo.com/og.jpg" />
       
    </head>
    <body class="bg-black">
        <ValidationPortal client:only="react" />
        <MenuComponent client:load />
        <slot/>
        <Footer/>
    </body>
</html>

<style is:global>
    * {
        font-family: 'Poppins', sans-serif;
    }
    .font-agave {
        font-family: 'Taviraj', serif;
    }

    .button-teak-gradient {
        @apply bg-gradient-to-r from-blue-700 to-cyan-500 border-blue-300 hover:from-blue-600 hover:to-cyan-400 border;
    }
</style>
