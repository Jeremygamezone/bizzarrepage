---
import { Icon } from 'astro-icon/components';
---

<footer class="bg-neutral-800 text-white" id="Pie">
    <div class="text-center mx-auto text-3xl p-8 leading-loose">
        <h2>¡Contáctame!</h2>
    </div>
    <hr class="border-gray-600" />
    <div class="w-4/5 md:w-3/4 flex justify-between mx-auto py-8 px-8">
        <div class="text-white lg:p-12 pt-7 lg:flex-1 text-center lg:text-left">
            <p class="text-xl pb-5">Contacto</p>
            <p class="text-sm">(+52) 331-840-0353</p>
            <p class="text-sm">jcastanedaarceo@gmail.com</p>
        </div>

        <div class="text-white lg:p-12 pt-7 lg:flex-1 flex flex-col items-center">
            <p class="text-xl pb-5">¿Ya revisaste mis redes?</p>
            <div class="flex space-x-4">
                <a href="https://www.facebook.com/SkibidiSigmaPotaxioEstoico" target="_blank" class="block">
                    <Icon name="social-media/facebook" class="w-12 h-12 text-blue-400" />
                </a>
                <a href="https://www.instagram.com/jzone124/" target="_blank" class="block">
                    <Icon name="social-media/instagram" class="w-12 h-12 text-orange-400" />
                </a>
                <a href="https://www.tiktok.com/@j1mmy3d" target="_blank" class="block">
                    <Icon name="social-media/tiktok" class="w-12 h-12 text-rose-400" />
                </a>
            </div>
        </div>
    </div>
    <div class="text-white text-sm w-full text-center pt-10 pb-4">
        2026. Todos los Derechos Reservados.
    </div>
    <div class="w-full text-center">
        <a
            target="_blank"
            href="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
            class="text-white hover:bg-gradient-to-r hover:from-[#78e28e] hover:to-[#2fb84c] inline-block hover:text-transparent hover:bg-clip-text text-xs duration-300"
            >by <span class="font-extrabold">Jeremy P. Castañeda Arceo</span></a
        >
    </div>
</footer>
