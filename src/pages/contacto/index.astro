---
import type { IMetadata } from '../../types/Metadata';
import PageLayout from '../../layouts/PageLayout.astro';
import Logo from '../../components/Logo.astro';
import { Icon } from 'astro-icon/components';
const metadata: IMetadata = {
    title: '¡Contáctame!',
    description:
        '¡Contáctame!',
    keywords:
        'contacto'
};
---

<PageLayout {...metadata}>
    <div class="absolute top-0 left-0 object-cover h-screen w-full bg-black opacity-80 -z-10"></div>
    <video class="absolute object-cover top-0 left-0 w-full h-screen -z-20" autoplay="" loop="" muted="" playsinline="">
        <source src="/videos/HellHype.mp4" type="video/mp4" />
    </video>
    <!-- <Logo isAbsolute={false} /> -->
     <img src="/FirmaAzul.png" alt="Sample Image" class="flex items-center justify-center mx-auto">
    <div class="mx-auto mt-12 w-10/12 max-w-full text-center">
        <h1 class="text-2xl md:text-4xl text-white border-b border-white pb-4 mb-4 font-agave">Contáctame</h1>
    </div>
    <div class="mx-auto grid grid-cols-1 lg:grid-cols-2 gap-4 w-10/12 max-w-full">
        <div class="bg-white p-4 md:p-8 rounded flex flex-col gap-4 order-2 lg:order-1">
            <p>
                Me puedes seguir en mis redes o ir a mi casa para contactarme. Quedo abierto a cualquier tipo de propuesta artística o de desarrollo
            </p>
            <div class="flex space-x-4 justify-center md:justify-start">
                <a href="https://www.facebook.com/SkibidiSigmaPotaxioEstoico" target="_blank" class="block">
                    <Icon name="social-media/facebook" class="w-12 h-12 text-blue-400" />
                </a>
                <a
                    href="https://www.instagram.com/jzone124/"
                    target="_blank"
                    class="block"
                >
                    <Icon name="social-media/instagram" class="w-12 h-12 text-orange-400" />
                </a>
                <a href="https://www.tiktok.com/@j1mmy3d" target="_blank" class="block">
                    <Icon name="social-media/tiktok" class="w-12 h-12 text-rose-400" />
                </a>
                <a href="https://www.reddit.com/user/BizarreBoi55/" target="_blank" class="block">
                    <Icon name="social-media/reddit" class="w-12 h-12 text-red-600" />
                </a>
            </div>
        </div>
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14951.113405557142!2d-103.25480555341974!3d20.474294893271097!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x842f49178be92afd%3A0xf8aa55b05890d1d9!2sAlbereda%20Residencial!5e0!3m2!1ses!2smx!4v1769409481079!5m2!1ses!2smx" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
</PageLayout>
