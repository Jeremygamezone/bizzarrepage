---
import type { IMetadata } from '../types/Metadata';
import PageLayout from '../layouts/PageLayout.astro';
import ParallaxBanner from '../components/ParallaxBanner';
import ProcessImg from '../components/proyectos/ProcessImg';

const metadata: IMetadata = {
    description: 'Pagina de presentacion para portafolio de Jeremy'
};
---

<PageLayout {...metadata}>
    <style>
        .carousel {
            margin: 100px auto;
            widht: 90%;
            display: flex;
            overflow-x: auto;
            gap: 1em;
            background-color: rgb(0,0,0,.60);
            padding-top: 25px;
            padding-bottom: 25px;
        }

        .carousel::-webkit-scrollbar {
            display: none;
        }

        .group {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1em;
            animation: spin 30s infinite linear;
            padding-right: 1em;
        }

        .card {
            flex: 0 0 5em;
            height: 5em;
            font-size: 3rem;
            border-radius: 1em;
            text-align: center;
            align-content: center;
            object-fit: cover;
        }

        @keyframes spin {
            from {
                translate: 0;
            }
            to {
                translate: -100%;
            }
        }
    </style>
    <div id="main">
        <ParallaxBanner bgClassName="bg-[url('/public/back01.jpg')] bg-repeat-y" client:load className="h-auto">
            <div class="text-center text-white backdrop-blur-md bg-red-800 bg-opacity-10 pt-8">
                <div class="w-4/5 md:w-3/4 mx-auto py-8 px-8">
                    <div class="leading-relaxed w-full mx-auto py-4">
                        <h2 class="text-5xl my-12">Jeremy P. Castañeda Arceo</h2>
                        <h2 class="text-4xl text-left">Desarrollador, artista y entusiasta de la tecnología.</h2>
                        <h2 class="text-2xl text-left md:text-justify font-normal py-4">
                            Poseo experiencia en la creación de aplicaciones web, campañas de marketing digital y gestión
                            de bases de datos, combinando desarrollo, soporte técnico e infraestructura para construir
                            soluciones digitales eficientes.
                            <br>
                            Por el otro lado, tengo conocimientos y habilidades que se ajustan a la medidad de quienes necesitan
                            soluciones referentes a diseños, renderizados, animaciones y/o creación de personajes.
                        </h2>
                    </div>

                    <div class="py-4" id="CV">
                        <h2 class="text-3xl py-4">¡Revisa mi CV!</h2>
                        <div class="grid grid-cols-1 mx-auto">
                            <a
                                href="public/JPCADESCV3.pdf"
                                download="CVSpanish.pdf"
                                class="lg bg-gradient-to-b from-orange-400 to-orange-800 text-white py-4 block rounded w-40 h-16 text-lg mx-auto my-8"
                                >Currículum</a
                            >
                            <!-- <a
                                href="public/JPCADEVCVE3.pdf"
                                download="CVEnglish.pdf"
                                class="lg bg-gradient-to-b from-blue-400 to-blue-800 text-white py-4 block rounded w-40 h-16 text-lg mx-auto my-8"
                                >CV inlgés</a
                            > -->
                        </div>
                    </div>
                </div>
            </div>
        </ParallaxBanner>

        <section id="self" class="flex bg-neutral-900 text-white py-8text-center font-normal py-8">
            <div class="mx-auto">
                <header class="text-4xl font-semibold">
                    <h1>¿Quién soy?</h1>
                </header>
            </div>
        </section>

        <ParallaxBanner bgClassName="bg-[url('/public/back02.jpg')] bg-repeat-y" client:load className="h-auto">
            <div class="grid justify-center w-full h-full bg-green-500 bg-opacity-10 backdrop-blur-md">
                <div class="w-4/5 md:w-3/4 mx-auto py-8 bg-black bg-opacity-60 px-8">
                    <div class="text-center flex text-white font-normal">
                        <p class="text-2xl text-left md:text-justify font-normal">
                            <img src="brands/utj2.png" class="float-right w-60 rounded mx-auto ml-4" alt="" />
                            Soy egresado del programa de Técnico Superior Universitario en la Universidad Tecnológica de Jalisco
                            , con formación en desarrollo web, bases de datos y tecnologías informáticas. A lo largo de mi
                            trayectoria he trabajado en la creación de aplicaciones web, gestión de bases de datos y soporte
                            tecnológico, integrando también conocimientos de diseño digital para desarrollar soluciones funcionales
                            y bien estructuradas. <!-- Me caracterizo por mi capacidad de adaptación ante nuevos retos
                    tecnológicos y por mantener una actitud constante de aprendizaje, lo que me permite desenvolverme en
                    distintos entornos dentro del área de la tecnología y el desarrollo de software. -->
                        </p>
                    </div>
                </div>
            </div>
        </ParallaxBanner>
        <section id="portafolio" class="bg-neutral-900 text-white text-center font-normal">
            <div class="w-4/5 md:w-3/4 mx-auto py-8 px-8">
                <header class="text-4xl font-semibold m-4 py-4">
                    <h1>Portafolio</h1>
                </header>
                <p class="text-2xl text-left md:text-justify font-normal py-6">
                    He trabajado en una amplia variedad de áreas informáticas y de diseño, enfocando gran parte de mi
                    experiencia en la creación de soluciones digitales que se ajustan la necesidad de cada cliente. A lo
                    largo de mi trayectoria he participado en proyectos que abarcan implementaciones de diseño,
                    desarrollo web, gestión de base de datos y orientacón de marketing digital
                </p>
                <br />
                <p class="text-2xl text-left md:text-justify font-normal">
                    Mi historial como desarrollador independiente con pequeñas y medianas empresas me ha permitido crear
                    una sólida capacidad para interpretar las necesidades de cada cliente y traducirlas en propuestas
                    visuales y soluciones digitales coherentes con su identidad. He aquí unos ejemplos de proyectos que
                    han salido adelante bajo mi cargo.
                </p>
            </div>
            <ParallaxBanner bgClassName="bg-[url('/public/back03.jpg')] bg-repeat-y" client:load className="h-auto">
                <div class="justify-center w-full h-full bg-purple-900 bg-opacity-20 backdrop-blur-md">
                    <div class="w-4/5 md:w-3/4 mx-auto py-8 bg-black bg-opacity-60">
                        <div class="md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-3 mx-auto justify-items-center">
                                <ProcessImg imgName="[url('/public/brands/warehouse.png')]" link='https://warehouse.rayopack.com/' title='RAYOPACK WAREHOUSE' description='Sistema web con administración de registros, rastreo de paquetes e inventario.'></ProcessImg>
                                <ProcessImg imgName='/public/brands/blender.png' title='Comisión personalizada' description='Servicio personalizado orientado a la creación de modelos y animaciones personales.'></ProcessImg>
                                <ProcessImg imgName='/public/brands/vsp01.png' link="" title='VSP Hikvision' description='Campaña de Marketing digital para la marca VSP anunciando su colaboración con Hikvision para distribuir e instalar su producto.'></ProcessImg>
                                <ProcessImg imgName='/public/brands/flor.png' link='https://laflordemayoneveria.com/' title='Flor de mayo neveria' description='Elaboración de página web con sección de menú para mayor alcance en la red.'></ProcessImg>
                                <ProcessImg imgName='/public/brands/tequila.png' link='https://www.autenticademipueblo.com/' title='Autentica de mi pueblo' description='Elaboración de página web con sección de productos y fichas técnicas para su promoción.'></ProcessImg>
                                <ProcessImg imgName='/public/brands/choko1.png' link='https://open.spotify.com/intl-es/artist/5eWaavRvzbhNII6GnAXkGf?si=1503dca062174125' title='Chokodrillo' description='Creación de contenido multimedia y realización de portadas para sencillos musicales.'></ProcessImg>
                        </div>
                    </div>
                </div>
            </ParallaxBanner>
        </section>
    </div>
</PageLayout>