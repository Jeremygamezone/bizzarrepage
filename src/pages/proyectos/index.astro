---
import type { IMetadata } from '../../types/Metadata';
import PageLayout from '../../layouts/PageLayout.astro';
import ParallaxBanner from '../../components/ParallaxBanner';
import ProcessImg from '../../components/proyectos/ProcessImg.vue';
import ProcessVideo from '../../components/proyectos/ProcessVideo.vue';
const metadata: IMetadata = {
    title: 'Proyectos',
    description: 'Descubre todos los proyectos exitosos que he hecho',
    keywords: 'animacion, modelaje, corto, programacion',
};
---

<PageLayout {...metadata}>
    <div class="text-white p-10 max-w-7xl w-full mx-auto my-5 h-auto py-11">
        <h1 class="text-4xl text-white font-agave text-center pt-3">Mis proyectos</h1><br />
        <h4 class="w-[60vw]">
            He aquí un pequeño listado de algunos proyectos que he sacado adelante con mis habilidades. Notece que
            podemos encontrar desde campañas publicitarias hasta desarrollo de sistemas web
        </h4>
    </div>
    <ParallaxBanner bgClassName="bg-[url('/geometry.jpg')] " client:load className="h-auto">
        <div class="grid justify-center w-full h-full px-4 bg-black bg-opacity-70">
            <div class="md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-3">
                <ProcessImg
                    img="warehouse.png"
                    title="Warehouse"
                    description="Página web con BD desarrollada en Laravel para la paquetería Rayopack. Mantiene el control sobre registros y rastreo de paquetes así como inventario automatizado."
                />
                <ProcessVideo
                    video="CorteFinalA.mp4"
                    title="Bonefish x Sneaker Fever"
                    description="Campaña de Marketing digital para la marca Bonefish celebrando su participación en Sneaker Fever 2025."
                />
                <ProcessImg
                    img="Comission.png"
                    title="Creación de personajes en 3D"
                    description="Servicio personalizado para creación de personajes en entornos 3D. Puede tener orientación a desarrollo de videojuegos, creación de moldes o propósito meramente personal."
                />
                <ProcessImg
                    img="super.png"
                    title="Curso de Blender desde cero"
                    description="Se ajusta a las necesidades de cada uno y abarca modelado, esculpido, animación, composición y creación de assets para Unity."
                />
                <ProcessVideo
                    video="VSPAnimation01K.mp4"
                    title="VSP Distribuidor de Hikvision"
                    description="Campaña de Marketing digital para la marca VSP anunciando su colaboración con Hikvision para distribuir e instalar su producto."
                />
                <ProcessImg
                    img="Portada01B.png"
                    title="Días Sombríos - Chokodrillo"
                    description="Elaboración de la portada para el sencillo 'Días sombríos', producido y escrito por Chokodrillo "
                />
            </div>
        </div>
    </ParallaxBanner>
</PageLayout>
