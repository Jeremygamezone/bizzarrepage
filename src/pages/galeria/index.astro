---
import type { IMetadata } from '../../types/Metadata';
import PageLayout from '../../layouts/PageLayout.astro';
import ParallaxBanner from '../../components/ParallaxBanner';
import VideoItem from '../../components/galeria/VideoItem.vue';
import ImageItem from '../../components/galeria/ImageItem.vue';

const metadata: IMetadata = {
    title: 'Galería',
    description: 'Descubre todos los proyectos exitosos que he hecho',
    keywords: 'renders,animacion, modelaje, corto, programacion,trabajo',
};
---

<PageLayout {...metadata}>
    <!-- <img src="/FirmaBlanco.png" alt="Sample Image" class="flex items-center justify-center mx-auto" /> -->
    <div class="flex items-center justify-center py-4">
        <div class="flex align-middle justify-between">
            <div class="text-white flex align-middle justify-center">
                <h1 class="text-2xl md:text-5xl font-agave font-bold my-[10vh]">Galería completa</h1>
            </div>
        </div>
    </div>
    <ParallaxBanner bgClassName="bg-[url('/images/LegoJeremy.png')]" client:load className="h-auto my-[5vh]">
        <div
            class="flex justify-center items-center w-[90%] h-auto bg-black bg-opacity-70 px-4 py-4 my-3 mx-auto py-auto"
        >
            <div class="uppercase text-white text-center flex flex-col gap-4 my-3 py-3">
                <div class="uppercase">
                    <h1 class="text-4xl text-white font-agave text-center pt-3 h-[10vh]">Imágenes y Renders</h1>
                    <div class="md:grid md:grid-cols-2 lg:grid-cols-4 md:gap-3">
                        <ImageItem img="Among Us Icon.png" />
                        <ImageItem img="ArmoredTitan1.png" />
                        <ImageItem img="Asagiri gun.png" />
                        <ImageItem img="BestBurger.png" />
                        <ImageItem img="CarbineRender.png" />
                        <ImageItem img="Castle Crashers Icon 2.png" />
                        <ImageItem img="Castle Crashers Icon.png" />
                        <ImageItem img="Diorama1.png" />
                        <ImageItem img="Dualshock06.png" />
                        <ImageItem img="Fabian.png" />
                        <ImageItem img="FunkoDoomguy.png" />
                        <ImageItem img="FunkoEdwin.png" />
                        <ImageItem img="FunkoSarahí.png" />
                        <ImageItem img="Hero Of The Village Link 03.png" />
                        <ImageItem img="Hero Of The Village Link 04.png" />
                        <ImageItem img="Hero Of The Village Link 05.png" />
                        <ImageItem img="Hylian Shield.png" />
                        <ImageItem img="I_render1.png" />
                        <ImageItem img="Jawblade.png" />
                        <ImageItem img="JeremyPlaying.png" />
                        <ImageItem img="LinkRender1.png" />
                        <ImageItem img="LowPolyMagnu8m.png" />
                        <ImageItem img="Metroid.png" />
                        <ImageItem img="Minecraft Icon.png" />
                        <ImageItem img="Montgomery Gator B.png" />
                        <ImageItem img="Rebecca01.png" />
                        <ImageItem img="RenderLenin.png" />
                        <ImageItem img="RevolverRanger.png" />
                        <ImageItem img="Riffle.png" />
                        <ImageItem img="Robert Pattinson.png" />
                        <ImageItem img="Room1.png" />
                        <ImageItem img="Shattered Sword3.png" />
                        <ImageItem img="SirenHead.png" />
                        <ImageItem img="SlendermanWireframe.png" />
                        <ImageItem img="The World 01.png" />
                        <ImageItem img="Yunny.png" />
                    </div>

                    <h1 class="text-4xl text-white font-agave text-center pt-3 h-[10vh]">Videos y animaciones</h1>
                    <div class="md:grid md:grid-cols-2 lg:grid-cols-4 md:gap-3">
                        <VideoItem video="A Hand.mp4">
                        </VideoItem>
                        <VideoItem video="Anims0001-0226.mp4">
                        </VideoItem>
                        <VideoItem video="Bad Apple.mp4">
                        </VideoItem>
                        <VideoItem video="CarbineReload0001-0090.mp4">
                        </VideoItem>
                        <VideoItem video="Dabloon Car Ep.010001-0700.mp4">
                        </VideoItem>
                        <VideoItem video="Dabloon Car Ep.010003-1010.mp4">
                        </VideoItem>
                        <VideoItem video="DoubleKickViewA0001-0080.mp4">
                        </VideoItem>
                        <VideoItem video="Intro Sin Audio.mp4">
                        </VideoItem>
                        <VideoItem video="RuningKnight0006-0026.mp4">
                        </VideoItem>
                        <VideoItem video="Slender The Return.mp4">
                        </VideoItem>
                        <VideoItem video="Soft & Wet.mp4">
                        </VideoItem>
                        <VideoItem video="VSP.mp4">
                        </VideoItem>
                        <VideoItem video="VSPmbON.mp4">
                        </VideoItem>
                    </div>
                </div>
            </div>
        </div>
    </ParallaxBanner></PageLayout
>
